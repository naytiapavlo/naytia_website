# 复制为 .env 后按需修改；.env 不入库（见根 .gitignore）
# 数据库文件位置（SQLite，ADR-001）
NAYTIA_SQLITE_PATH=data/app.db
# 会话有效期（天）
NAYTIA_SESSION_DAYS=14
# Cookie 安全属性：本地开发 false，HTTPS 部署必须 true
NAYTIA_COOKIE_SECURE=false
# 允许的跨域来源（逗号分隔；Astro dev 默认 4321）
NAYTIA_CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# .mcstructure 解析：上传文件字节上限（默认 32 MB）
NAYTIA_MCSTRUCTURE_MAX_BYTES=33554432
# .mcstructure 解析：单次解析的体素上限，即 size 的乘积（默认 16,777,216）
NAYTIA_MCSTRUCTURE_MAX_VOXELS=16777216

# ===== 论坛附件：结构文件与封面（ADR-006 / docs/plans/10）=====
# 落盘根目录（相对 backend/ 运行时的工作目录）。下面按类型分 structures/ 与 covers/
NAYTIA_FORUM_STORAGE_DIR=data/forum
# 随帖上传的 .mcstructure 上限（默认 10 MB，需求给定的硬边界）
NAYTIA_FORUM_STRUCTURE_MAX_BYTES=10485760
# 帖子封面上限（默认 5 MB）。服务端**不做压缩**（不引入 Pillow），按原图保存；
# 封面在列表里每次都会加载，建议在界面上引导用户压到 1 MB 以内
NAYTIA_FORUM_COVER_MAX_BYTES=5242880
# 材料清单最多入库多少条（默认 2000，按数量降序截断并如实标记）
NAYTIA_FORUM_MATERIAL_LIMIT=2000
# 3D 预览载荷（压缩前）的上限（默认 8 MB）。超过就不生成预览，只给材料清单
NAYTIA_FORUM_RENDER_MAX_BYTES=8388608

# ===== 逆向工作台：IDA Pro MCP（ADR-004）=====
# 后端必须与本机 IDA 在同一台机器上运行；先打开 IDA 并加载好 IDB，插件才会监听端口
NAYTIA_IDA_MCP_URL=http://127.0.0.1:13337/mcp
# 单次 MCP 调用超时（秒）。反编译大函数可能较慢
NAYTIA_IDA_MCP_TIMEOUT=60
# 未指定实例时的默认端口（BDS 的 bedrock_server.exe 就是 13337）
NAYTIA_IDA_DEFAULT_PORT=13337
# 实例端口白名单（逗号分隔）。留空=允许发现到的全部实例。
# 设成白名单可避免误连到正在手工操作的那个 IDA 实例
NAYTIA_IDA_ALLOWED_PORTS=

# ===== 逆向工作台的 AI 助手：DeepSeek（docs/plans/11）=====
# 不填则 /api/ai/chat 返回 503，前端显示「未配置」而不是报错。
# key 只在服务端使用，绝不下发到前端；申请：https://platform.deepseek.com
NAYTIA_DEEPSEEK_API_KEY=
# 接口基址（OpenAI 兼容的 /chat/completions 挂在它下面）
NAYTIA_DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型：deepseek-chat（默认，支持 function calling）
NAYTIA_DEEPSEEK_MODEL=deepseek-chat
# 单次调用超时（秒）。agent 一轮里可能调用多次
NAYTIA_DEEPSEEK_TIMEOUT=90
# 一条用户消息内最多几轮工具调用（防止模型来回调用停不下来）
NAYTIA_AI_MAX_TOOL_ROUNDS=6
# 对话上下文上限：最多几条历史消息 / 总字符预算
NAYTIA_AI_MAX_MESSAGES=24
NAYTIA_AI_MAX_CHARS=24000

# 配额（每 5 小时 3 轮）写在代码常量里，见 app/config.py 的
# AI_ROUNDS_PER_WINDOW / AI_WINDOW_SECONDS；改这里需要同步改常量。
