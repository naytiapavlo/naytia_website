---
/**
 * 作品页：封面滚动（一行）→ 研究时间轴 → B 站成果清单（纯文本）。
 *
 * 分工（模块约定）：页面只负责「排结构」，
 * 展示数据在 `modules/works/data.ts`，交互增强在 `modules/works/ui.ts`，
 * 样式在 `src/styles/works.css`（类名统一 wk- 前缀）。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/ui/PageHeading.astro';
import ShowcaseTrack from '../../components/ui/ShowcaseTrack.astro';
import { showcaseItems, timelineEntries, videoWorks } from '../../modules/works';
import '../../styles/works.css';
---

<BaseLayout title="作品" description="把想法放进方块世界，再把发现分享给你。">
  {/* JS 可用时才启用浮现动效：脚本没跑到，时间轴内容照样完整可读 */}
  <script is:inline>document.documentElement.classList.add('wk-js');</script>

  <PageHeading eyebrow="MADE WITH CURIOSITY" heading="我的作品" lead="把想法放进方块世界，再把发现分享给你。" />

  {/* ① 动态滚动的作品封面 */}
  <section class="wk-showcase" aria-labelledby="wk-showcase-title">
    <div class="wk-heading">
      <svg class="pixel" aria-hidden="true"><use href="#i-grid" /></svg>
      <h2 id="wk-showcase-title">作品封面</h2>
      <span class="en">SCROLLING COVERS</span>
      <span class="hint">悬停暂停 · 点封面看大图</span>
    </div>
    <div class="wk-marquee">
      <div class="wk-row"><ShowcaseTrack items={showcaseItems} /></div>
    </div>
  </section>

  {/* ② 动态时间轴 */}
  <section class="wk-timeline-section" aria-labelledby="wk-timeline-title">
    <div class="wk-heading">
      <svg class="pixel" aria-hidden="true"><use href="#i-bolt" /></svg>
      <h2 id="wk-timeline-title">研究时间轴</h2>
      <span class="en">TIMELINE</span>
      <span class="hint">向下滚动，进度线会跟着走</span>
    </div>
    <div class="wk-timeline-wrap" data-timeline>
      <span class="wk-rail" data-timeline-rail aria-hidden="true"><span class="wk-fill" data-timeline-fill></span></span>
      <ol class="wk-list">
        {timelineEntries.map((entry) => (
          <li class="wk-item" data-timeline-item>
            <span class="wk-dot" aria-hidden="true"></span>
            <div class="wk-body">
              <span class="wk-date">{entry.date}</span>
              <h3>{entry.title}</h3>
              <p>{entry.description}</p>
              <div class="wk-tags">
                {entry.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ③ B 站成果清单（纯文本） */}
  <section class="wk-achievements" aria-labelledby="wk-works-title">
    <div class="wk-heading">
      <svg class="pixel" aria-hidden="true"><use href="#i-note" /></svg>
      <h2 id="wk-works-title">Naytia_帕芙洛 的成果</h2>
      <span class="en">BILIBILI WORKS</span>
      <span class="hint">{videoWorks.length} 个视频作品</span>
    </div>
    <p class="wk-lead">B 站视频作品清单；封面见上方滚动区，逐条对应。</p>
    <ul class="wk-works">
      {videoWorks.map((work) => (
        <li class="wk-work">
          {work.title}
          <span class="wk-work-meta">{work.meta}</span>
        </li>
      ))}
    </ul>
  </section>

  {/* 封面灯箱：内容由 modules/works/ui.ts 填充 */}
  <dialog class="wk-lightbox" data-lightbox aria-label="作品封面大图">
    <div class="wk-lightbox-inner">
      <button class="wk-lightbox-close" type="button" data-lightbox-close aria-label="关闭大图">✕</button>
      <img data-lightbox-image src={showcaseItems[0].image} alt="" width="672" height="378" />
      <div class="wk-lightbox-meta">
        <div>
          <h3 data-lightbox-title></h3>
          <p data-lightbox-caption></p>
          <p class="wk-lightbox-tags" data-lightbox-tags hidden></p>
        </div>
        <div class="wk-lightbox-actions">
          <a class="wk-lightbox-link" data-lightbox-link hidden target="_blank" rel="noopener noreferrer">B 站视频 ↗</a>
          <span class="wk-lightbox-count" data-lightbox-counter></span>
          <button type="button" data-lightbox-prev aria-label="上一张">←</button>
          <button type="button" data-lightbox-next aria-label="下一张">→</button>
        </div>
      </div>
    </div>
  </dialog>
</BaseLayout>

<script>
  // 客户端增强：封面灯箱 + 时间轴动效。失败就退回静态展示（去掉 wk-js）。
  import { initWorksShowcase } from '../../modules/works';

  try {
    initWorksShowcase();
  } catch {
    document.documentElement.classList.remove('wk-js');
  }
</script>
